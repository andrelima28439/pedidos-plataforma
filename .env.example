# Copie para .env (nunca commite o .env real)
# Infra (docker-compose)
POSTGRES_USER=pedidos
POSTGRES_PASSWORD=pedidos123
POSTGRES_DB=pedidos
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
# Mongo/Redis (defaults do compose; override se mudar porta)
MONGODB_URI=mongodb://localhost:27017/estoque
REDIS_HOST=localhost
REDIS_PORT=6379
# Kafka (servicos Java usam dentro do compose: kafka:9092; local: localhost:29092)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Servicos (portas locais)
ESTOQUE_PORT=8081
PEDIDO_PORT=8082
PAGAMENTO_PORT=8083
NOTIFICACAO_PORT=8084
# JWT (pedido-service) — dev apenas
JWT_SECRET=dev-only-change-me-32chars-minimo-123456
# AWS LocalStack
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_COMPROVANTES_BUCKET=comprovantes-pagamentos
